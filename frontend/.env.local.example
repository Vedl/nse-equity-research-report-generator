# Copy to .env.local for local development.
# Never commit .env.local — it's in .gitignore.

# Backend API URL — used by lib/api.ts for Server Component fetches
# and by next.config.mjs for the browser-side rewrite proxy.
API_URL=http://localhost:8000

# Public backend URL exposed to the browser. Used for the PDF report SSE stream
# and download, which must hit the backend directly (the Vercel rewrite buffers
# streaming responses). Leave UNSET locally so those calls stay relative and the
# next.config rewrite proxies them to localhost:8000.
# NEXT_PUBLIC_API_URL=

# Production (set in Vercel dashboard, NOT here):
# API_URL=https://equity-research-api-production.up.railway.app
# NEXT_PUBLIC_API_URL=https://equity-research-api-production.up.railway.app
